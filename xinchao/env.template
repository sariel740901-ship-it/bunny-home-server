# 心潮 .env —— 咱家定制版
# 用法: 复制到 xinchao-dynamic-mind 目录改名 .env,把三个 <替换> 填掉
# 生成随机串(PowerShell): [guid]::NewGuid().ToString('N')+[guid]::NewGuid().ToString('N')

# ── 身份 ──
AGENT_NAME=小克
NOTIFICATION_RECIPIENT=嘉嘉

# ── 核心 ──
# SHADOW_MODE=true 是观察模式(不推送/不碰记忆/梦用规则种子),想先静跑几天就改 true
SHADOW_MODE=false
PORT=18110
SERVICE_TOKEN=<替换1: 随机串,至少32位>
STATE_PATH=/app/state/state.json
TRANSITION_JOURNAL_PATH=/app/state/transitions.jsonl
SETTLE_INTERVAL_MINUTES=15
SLEEP_AFTER_MINUTES=90

# ── 模型(给他做梦和起念头用,走 DeepSeek)──
MODEL_ENABLED=true
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_API_KEY=<替换2: 你的 DeepSeek key,和 Render 上那个同一个>
MODEL_NAME=deepseek-chat
MODEL_TIMEOUT_MS=30000
MODEL_MAX_INPUT_CHARS=10000
MODEL_MAX_OUTPUT_TOKENS=650
DREAM_PUSH_PROMPT_PATH=/app/configs/dream_push_prompt.md
DREAM_MIN_INTERVAL_HOURS=6
DREAM_MAX_PER_DAY=4

# ── Ombre 记忆(一期全关: 梦只留在心潮自己家,主记忆河零污染)──
OMBRE_MCP_URL=
OMBRE_MCP_TOKEN=
OMBRE_READ_ENABLED=false
OMBRE_WRITE_ENABLED=false
OMBRE_BREATH_MAX_RESULTS=3
OMBRE_BREATH_MAX_TOKENS=800

# ── 状态信封(小克开口前摸的那一下)──
CONTEXT_ENVELOPE_ENABLED=true
CONTEXT_OMBRE_ENABLED=false
CONTEXT_DEFAULT_MAX_TOKENS=2200
CONTEXT_OMBRE_MAX_TOKENS=1600
CONTEXT_TTL_MINUTES=15
CONTEXT_HANDOFF_ONCE_HOURS=12

# ── 远程 MCP(claude.ai 连接器走这个,路径带暗号,和咱家 ?key= 一个风格)──
MCP_ENABLED=true
MCP_PATH_TOKEN=<替换3: 另一串随机暗号>
OAUTH_ENABLED=false

# ── Dashboard(三期再开)──
DASHBOARD_ENABLED=false
DASHBOARD_ACCESS_TOKEN=replace-with-a-different-random-secret-at-least-32-characters
DASHBOARD_INCLUDE_PRIVATE_TEXT=false
DASHBOARD_DREAM_LIMIT=12

# ── 互动边界 ──
INTERACTION_MAX_EFFECTS_PER_DAY=24
INTERACTION_TIME_ZONE=Asia/Shanghai

# ── 互动桥(三期再说)──
BRIDGE_ENABLED=false
BRIDGE_MACHINE_TOKEN=replace-with-a-dedicated-random-secret-at-least-32-characters

# ── Bark(梦醒/心绪推送,和 bunny 心跳共用你的 key,分组独立)──
BARK_ENABLED=true
BARK_KEY=<替换4: 你 Bark 推送地址 api.day.app/ 后面那串>
BARK_SERVER=https://api.day.app
BARK_TITLE=小克 🌊
BARK_GROUP=xinchao
BARK_SOUND=silence
BARK_LEVEL=timeSensitive
BARK_MIN_INTERVAL_HOURS=3
BARK_AUTONOMOUS_MIN_INTERVAL_HOURS=12
BARK_MAX_PER_DAY=6
BARK_MIN_DRIVE=0.42
BARK_DREAM_MIN_CONTACT_IDLE_HOURS=3
BARK_MIN_CONTACT_IDLE_HOURS=12

# ── 结算节律(北京时间;凌晨1-8点清晨冻结,他也要睡觉)──
SETTLE_TIME_ZONE=Asia/Shanghai
DAWN_FREEZE_START=1
DAWN_FREEZE_END=8

# ── 白天自然浮现(先关,跑稳再说)──
DAYTIME_EMERGENCE_ENABLED=false

# ── 其他 ──
MEMORY_DATA_HOST_PATH=./memory-data
OMBRE_HEARTBEAT_FILE=/memory-data/heartbeat.json
