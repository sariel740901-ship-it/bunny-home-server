# 复制此文件为 .env 并填入真实值
PORT=3000

# Supabase — 从项目设置中获取
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_KEY=your-service-role-key

# 家门钥匙(强烈建议 — 设了之后所有 /api 接口都要带这把钥匙才能访问)
# 自己设一串随机字符(比如在终端跑 openssl rand -hex 16)。
# 网页端第一次访问会弹框问一次,输入后存在浏览器里,之后不再问。
# 不设则接口保持公开(部署在公网上等于任何人都能读走聊天记录,别裸奔)。
BUNNY_API_KEY=

# 主对话模型 API（Anthropic 或中转服务）
ANTHROPIC_API_KEY=sk-xxxxxxxx
ANTHROPIC_BASE_URL=https://api.anthropic.com

# 辅助压缩模型（DeepSeek，成本更低）
DEEPSEEK_API_KEY=sk-xxxxxxxx

# Ombre Brain 记忆桥（可选 — 配置后小克回复前会先检索记忆库）
# OMBRE_URL 是记忆库的公网地址(Cloudflare 隧道)，OMBRE_PASSWORD 是 Dashboard 密码
OMBRE_URL=https://brain.example.top
OMBRE_PASSWORD=
# 强烈建议再配 OB 的静态 MCP token(OB 侧 mcp_auth_mode 设 hybrid 后在 Dashboard 生成):
# 配了之后「记住」走 hold 工具逐字保存原话;不配则走导入管道,会被脱水总结成第三人称
OMBRE_MCP_TOKEN=

# 识图(可选 — 配置后她发的图片小克能看清;DeepSeek 不认图,由 Gemini 代看)
# 可直接复用 OB 压缩用的那把 Google AI Studio key;GEMINI_MODEL 默认 gemini-2.5-flash
GEMINI_API_KEY=
GEMINI_MODEL=

# 心跳(可选 — 配置后小克会在你沉默太久时主动留言)
# 自己设一串随机字符,外部定时器带着它访问 /api/heartbeat?token=xxx
HEARTBEAT_TOKEN=

# Bark 推送(可选 — 心跳留言同步推到 iPhone 锁屏)
# iPhone 装 Bark App,打开 App 复制你的推送地址,形如 https://api.day.app/你的Key(末尾不带斜杠)
BARK_URL=

# StackChan 联动(可选 — 心跳触发时,家里的小方块用他的声音说出那句话)
# 形如 https://stackchan.jiakeparents.top/announce?key=你的stackchan暗号
STACKCHAN_ANNOUNCE_URL=
