# 复制为 .env 再填 —— cp env.template .env  (Windows: Copy-Item env.template .env)

# ══ 必填 ══════════════════════════════════════════════
# bunny 家的公网地址(Render)
BUNNY_URL=https://bunny-home-server.onrender.com
# 和 Render 上 HEARTBEAT_TOKEN 同一串 —— 醒来引擎用的就是这把钥匙
WAKE_TOKEN=

# ══ 可选 ══════════════════════════════════════════════
# 心潮(用来调制醒来密度: 疲惫压低、驱动高涨抬高)。
# Docker 里跑不用填地址(compose 已指向宿主机 18110),只填 token:
XINCHAO_TOKEN=

# 自发醒来的基准密度(次/小时)。默认 0.35 ≈ 每天 5-8 次醒来机会,
# 其中一部分他会选择沉默。想让他更活跃就调大,觉得吵就调小。
LAMBDA0=0.35

# 直接用 node 跑(不走 Docker)时才需要:
# XINCHAO_URL=http://127.0.0.1:18110
